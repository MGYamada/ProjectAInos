module

public import ProjectAInos.SmoothAlgebra.Hom
public import Mathlib.RingTheory.Congruence.Basic

/-!
# Smooth congruences and their quotients

Quotients retain every finite smooth operation, including constants. The
generated congruence is constructed inductively, so its equality proofs have
finite support. This is useful for localization and the structure sheaf.
-/

@[expose] public section

noncomputable section

namespace ProjectAInos.SmoothAlgebra

open SmoothRing

variable {A B : Type*} [CommRing A] [Algebra ℝ A] [SmoothRing A]
  [CommRing B] [Algebra ℝ B] [SmoothRing B]

/-- A ring congruence compatible with all smooth operations. -/
structure SmoothRingCon (A : Type*) [CommRing A] [Algebra ℝ A] [SmoothRing A]
    extends RingCon A where
  op' : ∀ {n} (f : SmoothOperation n) (a b : Fin n → A),
    (∀ i, toRingCon (a i) (b i)) → toRingCon (op f a) (op f b)

namespace SmoothRingCon

variable (c : SmoothRingCon A)

/-- The underlying ring quotient, with its existing real-algebra structure. -/
abbrev Quotient := c.toRingCon.Quotient

def quotientOp {n} (f : SmoothOperation n) (a : Fin n → c.Quotient) :
    c.Quotient := c.toRingCon.mk' (op f (fun i => (a i).out))

theorem quotientOp_mk {n} (f : SmoothOperation n) (a : Fin n → A) :
    quotientOp c f (fun i => c.toRingCon.mk' (a i)) = c.toRingCon.mk' (op f a) := by
  apply Quotient.sound
  apply c.op'
  intro i
  exact Quotient.exact (Quotient.out_eq _)

instance : SmoothRing c.Quotient where
  op := quotientOp c
  op_proj i a := by
    change c.toRingCon.mk' (op (SmoothOperation.proj i) _) = _
    rw [op_proj]
    exact Quotient.out_eq _
  op_comp f g a := by
    have ha : (fun i => c.toRingCon.mk' (a i).out) = a := by
      funext i
      exact Quotient.out_eq _
    rw [← ha, quotientOp_mk]
    simp only [quotientOp_mk, op_comp]
  op_nullary r a := by
    change c.toRingCon.mk' (op (SmoothOperation.const 0 r) _) = _
    rw [op_const]
    rfl
  op_addition a := by
    change c.toRingCon.mk' (op SmoothOperation.addition _) = _
    rw [op_addition, _root_.map_add]
    exact congrArg₂ (· + ·) (Quotient.out_eq _) (Quotient.out_eq _)
  op_multiplication a := by
    change c.toRingCon.mk' (op SmoothOperation.multiplication _) = _
    rw [op_multiplication, _root_.map_mul]
    exact congrArg₂ (· * ·) (Quotient.out_eq _) (Quotient.out_eq _)

/-- The quotient projection preserves all smooth operations. -/
def projection : SmoothRingHom A c.Quotient where
  toFun := c.toRingCon.mk'
  map_op' f a := (quotientOp_mk c f a).symm

theorem projection_surjective : Function.Surjective c.projection := RingCon.mk'_surjective c.toRingCon

@[simp] theorem projection_eq_projection (a b : A) : c.projection a = c.projection b ↔ c.toRingCon a b :=
  Quotient.eq

/-- Descend a smooth morphism through a smooth congruence. -/
def lift (f : SmoothRingHom A B) (h : ∀ a b, c.toRingCon a b → f a = f b) :
    SmoothRingHom c.Quotient B where
  toFun := Quotient.lift f h
  map_op' g a := by
    have ha : (fun i => c.projection (a i).out) = a := by
      funext i
      exact Quotient.out_eq _
    rw [← ha, ← c.projection.map_op]
    exact f.map_op g _

@[simp] theorem lift_mk (f : SmoothRingHom A B)
    (h : ∀ a b, c.toRingCon a b → f a = f b) (a : A) : c.lift f h (c.projection a) = f a := rfl

@[ext] theorem hom_ext {f g : SmoothRingHom c.Quotient B}
    (h : ∀ a, f (c.projection a) = g (c.projection a)) : f = g := by
  ext b
  obtain ⟨a, rfl⟩ := c.projection_surjective b
  exact h a

/-- The equivalence relation generated by equations and smooth substitution. -/
inductive Generated (r : A → A → Prop) : A → A → Prop
  | of {a b} : r a b → Generated r a b
  | refl (a) : Generated r a a
  | symm {a b} : Generated r a b → Generated r b a
  | trans {a b d} : Generated r a b → Generated r b d → Generated r a d
  | op {n} (f : SmoothOperation n) (a b : Fin n → A) :
      (∀ i, Generated r (a i) (b i)) → Generated r (op f a) (op f b)

/-- Generate a smooth congruence from any family of equations. -/
def generate (r : A → A → Prop) : SmoothRingCon A where
  r := Generated r
  iseqv := ⟨Generated.refl, Generated.symm, Generated.trans⟩
  add' {a b d e} hab hde := by
    simpa using Generated.op SmoothOperation.addition ![a, d] ![b, e]
      (by intro i; fin_cases i <;> assumption)
  mul' {a b d e} hab hde := by
    simpa using Generated.op SmoothOperation.multiplication ![a, d] ![b, e]
      (by intro i; fin_cases i <;> assumption)
  op' := Generated.op

/-- A morphism which respects the generating equations respects their closure. -/
theorem generated_map {r : A → A → Prop} (f : SmoothRingHom A B)
    (h : ∀ a b, r a b → f a = f b) {a b} (hab : Generated r a b) : f a = f b := by
  induction hab with
  | of hr => exact h _ _ hr
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | op g a b _ ih => simp only [f.map_op]; congr 1; funext i; exact ih i

end SmoothRingCon
end ProjectAInos.SmoothAlgebra
