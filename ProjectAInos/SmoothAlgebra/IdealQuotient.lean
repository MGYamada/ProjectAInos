public import ProjectAInos.SmoothAlgebra.Point
public import Mathlib.RingTheory.Ideal.Span

/-!
# The quotient of a C-infinity ring by an ideal

By Hadamard's lemma, the relation `a − b ∈ I` of an ideal `I` is compatible
with all smooth operations: `Φ_f(a) − Φ_f(b) = Σᵢ (aᵢ − bᵢ) Φ_{gᵢ}(a, b)`. So
the quotient of a C-infinity ring by an ordinary ideal is a C-infinity ring
(`SmoothRingCon.ofIdeal`), and the morphisms out of it are the morphisms that
vanish on the ideal (`SmoothRingCon.ofIdealHomEquiv`).

The congruence generated by a family of equations `eₖ = 0` is the congruence
of the ideal generated by the `eₖ` (`SmoothRingCon.generate_eq_ofIdeal`). So a
ring presented by equations is the quotient by the ideal of the equations.
-/

@[expose] public section

noncomputable section

namespace ProjectAInos.SmoothAlgebra

variable {A B : Type*} [CommRing A] [Algebra ℝ A] [SmoothRing A]
  [CommRing B] [Algebra ℝ B] [SmoothRing B]

namespace SmoothRingCon

/-- The congruence of an ideal: `a ~ b` when `a − b ∈ I`. It is compatible
with the smooth operations by Hadamard's lemma. -/
def ofIdeal (I : Ideal A) : SmoothRingCon A where
  r a b := a - b ∈ I
  iseqv := ⟨fun a => by rw [sub_self]; exact I.zero_mem,
    fun {a b} h => by rw [← neg_sub]; exact I.neg_mem h,
    fun {a b c} h₁ h₂ => by rw [← sub_add_sub_cancel a b c]; exact I.add_mem h₁ h₂⟩
  add' {a b c d} h₁ h₂ := by
    rw [add_sub_add_comm]
    exact I.add_mem h₁ h₂
  mul' {a b c d} h₁ h₂ := by
    have h : a * c - b * d = a * (c - d) + (a - b) * d := by ring
    rw [h]
    exact I.add_mem (I.mul_mem_left a h₂) (I.mul_mem_right d h₁)
  op' f a b h := by
    change SmoothRing.op f a - SmoothRing.op f b ∈ I
    rw [SmoothRing.op_sub_op]
    exact I.sum_mem fun i _ => I.mul_mem_right _ (h i)

theorem ofIdeal_apply {I : Ideal A} {a b : A} : (ofIdeal I).toRingCon a b ↔ a - b ∈ I :=
  Iff.rfl

/-- Two elements have the same class exactly when their difference is in the
ideal. -/
theorem ofIdeal_projection_eq_iff {I : Ideal A} {a b : A} :
    (ofIdeal I).projection a = (ofIdeal I).projection b ↔ a - b ∈ I :=
  (ofIdeal I).projection_eq_projection a b

/-- The kernel of the projection is the ideal. -/
theorem ofIdeal_projection_eq_zero_iff {I : Ideal A} {a : A} :
    (ofIdeal I).projection a = 0 ↔ a ∈ I := by
  rw [← SmoothRingHom.map_zero (ofIdeal I).projection, ofIdeal_projection_eq_iff, sub_zero]

/-- The morphisms out of the quotient by an ideal are the morphisms that
vanish on the ideal. -/
def ofIdealHomEquiv (I : Ideal A) :
    SmoothRingHom (ofIdeal I).Quotient B ≃ {f : SmoothRingHom A B // ∀ a ∈ I, f a = 0} where
  toFun g := ⟨g.comp (ofIdeal I).projection, fun a ha => by
    rw [SmoothRingHom.comp_apply, ofIdeal_projection_eq_zero_iff.mpr ha, SmoothRingHom.map_zero]⟩
  invFun f := (ofIdeal I).lift f.1 fun a b hab => by
    have h := f.2 (a - b) hab
    rwa [SmoothRingHom.map_sub, sub_eq_zero] at h
  left_inv g := (ofIdeal I).hom_ext fun _ => rfl
  right_inv f := Subtype.ext (SmoothRingHom.ext fun _ => rfl)

/-- The congruence generated by the equations `eₖ = 0` relates `a` and `b`
exactly when `a − b` is in the ideal generated by the `eₖ`. -/
theorem generated_iff_sub_mem_span {K : Type*} (e : K → A) {a b : A} :
    Generated (fun x y => ∃ k, x = e k ∧ y = 0) a b ↔ a - b ∈ Ideal.span (Set.range e) := by
  constructor
  · intro h
    induction h with
    | of hr =>
      obtain ⟨k, rfl, rfl⟩ := hr
      rw [sub_zero]
      exact Ideal.subset_span ⟨k, rfl⟩
    | refl a => exact (ofIdeal _).refl a
    | symm _ ih => exact (ofIdeal _).symm ih
    | trans _ _ ih₁ ih₂ => exact (ofIdeal _).trans ih₁ ih₂
    | op f a b _ ih => exact (ofIdeal _).op' f a b ih
  · intro h
    have hzero : ∀ x ∈ Ideal.span (Set.range e),
        Generated (fun x y => ∃ k, x = e k ∧ y = 0) x 0 := by
      intro x hx
      refine Submodule.span_induction
        (p := fun x _ => Generated (fun x y => ∃ k, x = e k ∧ y = 0) x 0) ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨k, rfl⟩
        exact Generated.of ⟨k, rfl, rfl⟩
      · exact Generated.refl 0
      · intro x y _ _ hx hy
        have h' := (generate fun x y => ∃ k, x = e k ∧ y = 0).add' hx hy
        rwa [add_zero] at h'
      · intro r x _ hx
        have h' := (generate fun x y => ∃ k, x = e k ∧ y = 0).mul' (Generated.refl r) hx
        rwa [mul_zero] at h'
    have h' := (generate fun x y => ∃ k, x = e k ∧ y = 0).add' (hzero _ h) (Generated.refl b)
    rwa [sub_add_cancel, zero_add] at h'

end SmoothRingCon

namespace FreeSmoothRing

variable {ι K : Type*}

/-- Two morphisms out of a free ring that agree modulo an ideal on the
generators agree modulo the ideal on every element. -/
theorem hom_sub_hom_mem {I : Ideal A} {φ ψ : SmoothRingHom (FreeSmoothRing ι) A}
    (h : ∀ i, φ (generator i) - ψ (generator i) ∈ I) (f : FreeSmoothRing ι) :
    φ f - ψ f ∈ I := by
  have hφψ : (SmoothRingCon.ofIdeal I).projection.comp φ =
      (SmoothRingCon.ofIdeal I).projection.comp ψ :=
    hom_ext fun i => SmoothRingCon.ofIdeal_projection_eq_iff.mpr (h i)
  exact SmoothRingCon.ofIdeal_projection_eq_iff.mp (congrArg (fun χ => χ f) hφψ)

/-- A morphism maps a generated ideal into an ideal that contains the images of
the generators. -/
theorem _root_.ProjectAInos.SmoothAlgebra.SmoothRingHom.mem_of_mem_span {s : Set A}
    {J : Ideal B} {φ : SmoothRingHom A B} (h : ∀ a ∈ s, φ a ∈ J) {a : A}
    (ha : a ∈ Ideal.span s) : φ a ∈ J := by
  refine Submodule.span_induction (p := fun x _ => φ x ∈ J) h ?_ ?_ ?_ ha
  · rw [SmoothRingHom.map_zero]
    exact zero_mem _
  · intro x y _ _ hx hy
    rw [SmoothRingHom.map_add]
    exact add_mem hx hy
  · intro r x _ hx
    rw [smul_eq_mul, SmoothRingHom.map_mul]
    exact Ideal.mul_mem_left _ _ hx

/-- A morphism that vanishes on the generators of an ideal vanishes on the
ideal. -/
theorem _root_.ProjectAInos.SmoothAlgebra.SmoothRingHom.eq_zero_of_mem_span {s : Set A}
    {φ : SmoothRingHom A B} (h : ∀ a ∈ s, φ a = 0) {a : A} (ha : a ∈ Ideal.span s) :
    φ a = 0 := by
  refine Submodule.span_induction (p := fun x _ => φ x = 0) h (SmoothRingHom.map_zero φ) ?_ ?_ ha
  · intro x y _ _ hx hy
    rw [SmoothRingHom.map_add, hx, hy, add_zero]
  · intro r x _ hx
    rw [smul_eq_mul, SmoothRingHom.map_mul, hx, mul_zero]

/-- Two elements of the free ring have the same class in the ring presented by
the equations `eₖ = 0` exactly when their difference is in the ideal generated
by the `eₖ`: a presented ring is the quotient by the ideal of its equations. -/
theorem presented_projection_eq_iff (e : K → FreeSmoothRing ι) {a b : FreeSmoothRing ι} :
    (SmoothRingCon.generate (equationRel e)).projection a =
        (SmoothRingCon.generate (equationRel e)).projection b ↔
      a - b ∈ Ideal.span (Set.range e) :=
  ((SmoothRingCon.generate (equationRel e)).projection_eq_projection a b).trans
    (SmoothRingCon.generated_iff_sub_mem_span e)

/-- An element of the free ring vanishes in the presented ring exactly when it
is in the ideal generated by the equations. -/
theorem presented_projection_eq_zero_iff (e : K → FreeSmoothRing ι) {a : FreeSmoothRing ι} :
    (SmoothRingCon.generate (equationRel e)).projection a = 0 ↔
      a ∈ Ideal.span (Set.range e) := by
  rw [← SmoothRingHom.map_zero (SmoothRingCon.generate (equationRel e)).projection,
    presented_projection_eq_iff, sub_zero]

end FreeSmoothRing

end ProjectAInos.SmoothAlgebra
