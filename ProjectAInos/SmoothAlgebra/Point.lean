/-!
# Points and tangent vectors of a C-infinity ring

A point of a C-infinity ring `A` is a morphism `A → ℝ`. A tangent vector is a
morphism `A → ℝ[ε]` into the dual numbers: a point together with a velocity.
For a mechanical system with the ring of functions `A`, a state is a tangent
vector (Landau–Lifshitz §1).

For the free ring on `ι`, the points are the families `a : ι → ℝ` and the
tangent vectors are the pairs `(a, v)`: the morphism `xᵢ ↦ aᵢ + ε vᵢ` takes an
element `s` to `s(a) + ε Σᵢ (∂ᵢ s)(a) vᵢ`. A change of co-ordinates
`xᵢ ↦ yᵢ(x)` therefore takes `(a, v)` to `(y(a), J v)` with the Jacobian
`Jᵢⱼ = (∂ⱼ yᵢ)(a)`.

For the quotient of `A` by the congruence generated by a family of relations,
the points and the tangent vectors are those of `A` that respect the
relations. For the free ring with the equations `eₖ = 0`, the tangent vectors
are the pairs `(a, v)` with `eₖ(a) = 0` and `Σᵢ (∂ᵢ eₖ)(a) vᵢ = 0`: the
velocities tangent to the constraints.
-/

@[expose] public section

noncomputable section

namespace ProjectAInos.SmoothAlgebra

open SmoothRing SmoothOperation TrivSqZeroExt

/-- A point of a C-infinity ring: a morphism to the real numbers. -/
abbrev Point (A : Type*) [CommRing A] [Algebra ℝ A] [SmoothRing A] := SmoothRingHom A ℝ

/-- A tangent vector of a C-infinity ring: a morphism to the dual numbers. -/
abbrev TangentPoint (A : Type*) [CommRing A] [Algebra ℝ A] [SmoothRing A] :=
  SmoothRingHom A (DualNumber ℝ)

section Hom

variable {A B : Type*} [CommRing A] [Algebra ℝ A] [SmoothRing A] [CommRing B] [Algebra ℝ B]
  [SmoothRing B]

/-- The base point of a tangent vector. -/
def TangentPoint.base (φ : TangentPoint A) : Point A := DualNumber.fstHom.comp φ

/-- A morphism of C-infinity rings acts on points in the opposite direction. -/
def Point.map (f : SmoothRingHom A B) (x : Point B) : Point A := x.comp f

/-- A morphism of C-infinity rings acts on tangent vectors in the opposite
direction. -/
def TangentPoint.map (f : SmoothRingHom A B) (φ : TangentPoint B) : TangentPoint A := φ.comp f

/-- An isomorphism of C-infinity rings, given as a pair of inverse morphisms,
is a change of co-ordinates: it induces a bijection of the tangent vectors. -/
def TangentPoint.congr (f : SmoothRingHom A B) (g : SmoothRingHom B A)
    (hfg : f.comp g = SmoothRingHom.id B) (hgf : g.comp f = SmoothRingHom.id A) :
    TangentPoint B ≃ TangentPoint A where
  toFun := TangentPoint.map f
  invFun := TangentPoint.map g
  left_inv φ := by
    refine SmoothRingHom.ext fun b => ?_
    change φ (f (g b)) = φ b
    rw [← SmoothRingHom.comp_apply f g, hfg, SmoothRingHom.id_apply]
  right_inv φ := by
    refine SmoothRingHom.ext fun a => ?_
    change φ (g (f a)) = φ a
    rw [← SmoothRingHom.comp_apply g f, hgf, SmoothRingHom.id_apply]

end Hom

namespace FreeSmoothRing

variable {ι : Type*}

/-- The points of the free ring are the families of real numbers. -/
def pointEquiv : Point (FreeSmoothRing ι) ≃ (ι → ℝ) where
  toFun x i := x (generator i)
  invFun a := lift a
  left_inv _ := hom_ext fun i => lift_generator _ i
  right_inv a := funext fun i => lift_generator a i

/-- The dual number `a + ε v`. -/
def dual (a v : ℝ) : DualNumber ℝ := inl a + inr v

@[simp] theorem fst_dual (a v : ℝ) : (dual a v).fst = a := by simp [dual]

@[simp] theorem snd_dual (a v : ℝ) : (dual a v).snd = v := by simp [dual]

/-- The tangent vector of the free ring with the position `a` and the
velocity `v`: the morphism `xᵢ ↦ aᵢ + ε vᵢ`. -/
def tangentPoint (a v : ι → ℝ) : TangentPoint (FreeSmoothRing ι) :=
  lift fun i => dual (a i) (v i)

@[simp] theorem tangentPoint_generator (a v : ι → ℝ) (i : ι) :
    tangentPoint a v (generator i) = dual (a i) (v i) :=
  lift_generator _ i

/-- The tangent vectors of the free ring are the pairs of a position and a
velocity: a state of the system. -/
def tangentPointEquiv : TangentPoint (FreeSmoothRing ι) ≃ (ι → ℝ) × (ι → ℝ) where
  toFun φ := (fun i => (φ (generator i)).fst, fun i => (φ (generator i)).snd)
  invFun av := tangentPoint av.1 av.2
  left_inv φ := hom_ext fun i => by
    rw [tangentPoint_generator, dual, inl_fst_add_inr_snd_eq]
  right_inv av := by
    refine Prod.ext (funext fun i => ?_) (funext fun i => ?_)
    · change (tangentPoint av.1 av.2 (generator i)).fst = av.1 i
      rw [tangentPoint_generator, fst_dual]
    · change (tangentPoint av.1 av.2 (generator i)).snd = av.2 i
      rw [tangentPoint_generator, snd_dual]

/-- The value of an element at a tangent vector has the value at the point as
its real part. -/
theorem fst_tangentPoint (a v : ι → ℝ) (s : FreeSmoothRing ι) :
    (tangentPoint a v s).fst = lift a s := by
  have h : DualNumber.fstHom.comp (tangentPoint a v) = lift a := hom_ext fun i => by
    rw [SmoothRingHom.comp_apply, tangentPoint_generator, lift_generator,
      DualNumber.fstHom_apply, fst_dual]
  exact congrArg (fun φ : SmoothRingHom (FreeSmoothRing ι) ℝ => φ s) h

variable [Fintype ι] [DecidableEq ι]

/-- The value of an element at a tangent vector has the derivative along the
velocity as its infinitesimal part: `s(a + εv) = s(a) + ε Σᵢ (∂ᵢ s)(a) vᵢ`. -/
theorem snd_tangentPoint (a v : ι → ℝ) (s : FreeSmoothRing ι) :
    (tangentPoint a v s).snd = ∑ i, lift a (partialDerivation i s) * v i := by
  have hs : (tangentPoint a v s).snd =
      ∑ j, op (partialDeriv j (presentation s).operation)
        (fun k => a ((presentation s).indices k)) * v ((presentation s).indices j) := by
    conv_lhs => rw [presentation_eq s]
    rw [tangentPoint, SmoothRingHom.map_op, DualNumber.snd_op]
    simp only [lift_generator, fst_dual, snd_dual]
  rw [hs]
  simp only [lift_partialDerivation_eq_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finset.sum_eq_single ((presentation s).indices j)]
  · simp only [↓reduceIte, mul_one]
  · intro i _ hi
    simp only [Ne.symm hi, ↓reduceIte, mul_zero, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- A change of co-ordinates `xᵢ ↦ yᵢ` takes the state `(a, v)` to
`(y(a), J v)`, with the Jacobian `Jᵢⱼ = (∂ⱼ yᵢ)(a)`. -/
theorem tangentPoint_map_lift (y : ι → FreeSmoothRing ι) (a v : ι → ℝ) :
    TangentPoint.map (lift y) (tangentPoint a v) =
      tangentPoint (fun i => lift a (y i))
        fun i => ∑ j, lift a (partialDerivation j (y i)) * v j := by
  refine hom_ext fun i => ?_
  change tangentPoint a v (lift y (generator i)) = _
  rw [lift_generator, tangentPoint_generator]
  refine TrivSqZeroExt.ext ?_ ?_
  · rw [fst_tangentPoint, fst_dual]
  · rw [snd_tangentPoint, snd_dual]

end FreeSmoothRing

/-! ### Quotients by relations -/

namespace SmoothRingCon

variable {A B : Type*} [CommRing A] [Algebra ℝ A] [SmoothRing A] [CommRing B] [Algebra ℝ B]
  [SmoothRing B]

/-- The morphisms out of the quotient by the congruence generated by a family
of relations are the morphisms that respect the relations. -/
def generateHomEquiv (r : A → A → Prop) :
    SmoothRingHom (generate r).Quotient B ≃
      {f : SmoothRingHom A B // ∀ a b, r a b → f a = f b} where
  toFun g := ⟨g.comp (generate r).projection, fun a b hab => by
    have h : (generate r).projection a = (generate r).projection b :=
      ((generate r).projection_eq_projection a b).mpr (Generated.of hab)
    rw [SmoothRingHom.comp_apply, SmoothRingHom.comp_apply, h]⟩
  invFun f := (generate r).lift f.1 fun _ _ hab => generated_map f.1 f.2 hab
  left_inv g := (generate r).hom_ext fun _ => rfl
  right_inv f := Subtype.ext (SmoothRingHom.ext fun _ => rfl)

end SmoothRingCon

namespace FreeSmoothRing

variable {ι K : Type*}

/-- The relations `eₖ = 0` for a family of elements of the free ring. -/
def equationRel (e : K → FreeSmoothRing ι) (a b : FreeSmoothRing ι) : Prop :=
  ∃ k, a = e k ∧ b = 0

/-- The C-infinity ring presented by the generators `ι` and the equations
`eₖ = 0`. -/
abbrev Presented (e : K → FreeSmoothRing ι) :=
  (SmoothRingCon.generate (equationRel e)).Quotient

/-- The points of a presented ring are the common zeros of the equations. -/
def presentedPointEquiv (e : K → FreeSmoothRing ι) :
    Point (Presented e) ≃ {a : ι → ℝ // ∀ k, lift a (e k) = 0} :=
  (SmoothRingCon.generateHomEquiv (B := ℝ) (equationRel e)).trans
    (pointEquiv.subtypeEquiv fun x => by
      have hx : lift (pointEquiv x) = x := pointEquiv.symm_apply_apply x
      constructor
      · intro h k
        rw [hx, h (e k) 0 ⟨k, rfl, rfl⟩, SmoothRingHom.map_zero]
      · rintro h _ _ ⟨k, rfl, rfl⟩
        have hk := h k
        rw [hx] at hk
        rw [hk, SmoothRingHom.map_zero])

variable [Fintype ι] [DecidableEq ι]

/-- The tangent vectors of a presented ring are the states `(a, v)` with
`eₖ(a) = 0` and `Σᵢ (∂ᵢ eₖ)(a) vᵢ = 0`: the position satisfies the equations
and the velocity is tangent to them. -/
def presentedTangentPointEquiv (e : K → FreeSmoothRing ι) :
    TangentPoint (Presented e) ≃
      {av : (ι → ℝ) × (ι → ℝ) // ∀ k, lift av.1 (e k) = 0 ∧
        ∑ i, lift av.1 (partialDerivation i (e k)) * av.2 i = 0} :=
  (SmoothRingCon.generateHomEquiv (B := DualNumber ℝ) (equationRel e)).trans
    (tangentPointEquiv.subtypeEquiv fun φ => by
      have hφ : tangentPoint (tangentPointEquiv φ).1 (tangentPointEquiv φ).2 = φ :=
        tangentPointEquiv.symm_apply_apply φ
      constructor
      · intro h k
        have hk := h (e k) 0 ⟨k, rfl, rfl⟩
        rw [SmoothRingHom.map_zero, ← hφ] at hk
        exact ⟨by rw [← fst_tangentPoint, hk, TrivSqZeroExt.fst_zero],
          by rw [← snd_tangentPoint, hk, TrivSqZeroExt.snd_zero]⟩
      · rintro h _ _ ⟨k, rfl, rfl⟩
        rw [SmoothRingHom.map_zero, ← hφ]
        refine TrivSqZeroExt.ext ?_ ?_
        · rw [fst_tangentPoint, (h k).1, TrivSqZeroExt.fst_zero]
        · rw [snd_tangentPoint, (h k).2, TrivSqZeroExt.snd_zero])

/-! ### The circle -/

/-- The equation `x₀² + x₁² − 1 = 0` of the unit circle. -/
def circleEquation : Unit → FreeSmoothRing (Fin 2) :=
  fun _ => generator 0 * generator 0 + generator 1 * generator 1 - 1

theorem lift_circleEquation (a : Fin 2 → ℝ) :
    lift a (circleEquation ()) = a 0 * a 0 + a 1 * a 1 - 1 := by
  simp only [circleEquation, SmoothRingHom.map_sub, SmoothRingHom.map_add,
    SmoothRingHom.map_mul, SmoothRingHom.map_one, lift_generator]

/-- The derivative of the equation of the circle along a velocity is
`2 (a · v)`. -/
theorem sum_lift_partialDerivation_circleEquation (a v : Fin 2 → ℝ) :
    ∑ i, lift a (partialDerivation i (circleEquation ())) * v i =
      2 * (a 0 * v 0 + a 1 * v 1) := by
  have h00 : partialDerivation (0 : Fin 2) (generator (0 : Fin 2)) = 1 :=
    partialDerivation_generator_self 0
  have h11 : partialDerivation (1 : Fin 2) (generator (1 : Fin 2)) = 1 :=
    partialDerivation_generator_self 1
  have h01 : partialDerivation (0 : Fin 2) (generator (1 : Fin 2)) = 0 :=
    partialDerivation_generator_of_ne (by decide)
  have h10 : partialDerivation (1 : Fin 2) (generator (0 : Fin 2)) = 0 :=
    partialDerivation_generator_of_ne (by decide)
  simp only [Fin.sum_univ_two, circleEquation, map_sub, map_add, SmoothDerivation.map_mul,
    SmoothDerivation.map_one, h00, h11, h01, h10, smul_eq_mul, mul_one, mul_zero, sub_zero,
    SmoothRingHom.map_add, SmoothRingHom.map_zero, lift_generator]
  ring

/-- The states of the circle: the pairs `(a, v)` with `|a|² = 1` and
`a · v = 0`. -/
def circleTangentPointEquiv :
    TangentPoint (Presented circleEquation) ≃
      {av : (Fin 2 → ℝ) × (Fin 2 → ℝ) // av.1 0 * av.1 0 + av.1 1 * av.1 1 = 1 ∧
        av.1 0 * av.2 0 + av.1 1 * av.2 1 = 0} :=
  (presentedTangentPointEquiv circleEquation).trans
    (Equiv.subtypeEquivRight fun av => by
      constructor
      · intro h
        have h1 := (h ()).1
        have h2 := (h ()).2
        rw [lift_circleEquation] at h1
        rw [sum_lift_partialDerivation_circleEquation] at h2
        exact ⟨by linarith, by linarith⟩
      · rintro ⟨h1, h2⟩ _
        rw [lift_circleEquation, sum_lift_partialDerivation_circleEquation]
        exact ⟨by linarith, by linarith⟩)

end FreeSmoothRing

end ProjectAInos.SmoothAlgebra
