module

public import ProjectAInos.SmoothAlgebra.Congruence
public import ProjectAInos.SmoothAlgebra.Models
public import ProjectAInos.SmoothAlgebra.LocalInverse
public import Mathlib.RingTheory.LocalRing.RingHom.Basic

/-!
# C∞ localization at a real point

The localization is a quotient by the smooth congruence generated by
`a * s = b * s`, where `x s ≠ 0`. A smooth cutoff supplies local inverses.
The universal property is proved in C∞-rings, not assumed from ordinary
commutative-ring localization. This implements Joyce, §2.3, at real points.
-/

@[expose] public section

noncomputable section

namespace ProjectAInos.SmoothAlgebra

open SmoothRing

variable {A B C : Type*} [CommRing A] [Algebra ℝ A] [SmoothRing A]
  [CommRing B] [Algebra ℝ B] [SmoothRing B]
  [CommRing C] [Algebra ℝ C] [SmoothRing C]

/-- Equations forced by inverting elements nonzero at a real point. -/
def pointRelation (x : SmoothRingHom A ℝ) (a b : A) : Prop :=
  ∃ s : A, x s ≠ 0 ∧ a * s = b * s

/-- The smooth congruence generated by the localization equations. -/
def pointCongruence (x : SmoothRingHom A ℝ) : SmoothRingCon A :=
  SmoothRingCon.generate (pointRelation x)

/-- The C∞-ring localized at the real point `x`. -/
abbrev PointLocalization (x : SmoothRingHom A ℝ) := (pointCongruence x).Quotient

namespace PointLocalization

variable (x : SmoothRingHom A ℝ)

/-- The canonical projection to a point localization. -/
def of : SmoothRingHom A (PointLocalization x) := (pointCongruence x).projection

theorem of_surjective : Function.Surjective (of x) := (pointCongruence x).projection_surjective

@[simp] theorem of_eq_of (a b : A) : of x a = of x b ↔
    SmoothRingCon.Generated (pointRelation x) a b := Quotient.eq

/-- Factor a morphism which inverts every element nonzero at `x`. -/
def lift (f : SmoothRingHom A B) (hf : ∀ s, x s ≠ 0 → IsUnit (f s)) :
    SmoothRingHom (PointLocalization x) B :=
  (pointCongruence x).lift f fun a b h =>
    SmoothRingCon.generated_map f (fun a b ⟨s, hs, hab⟩ =>
      (hf s hs).mul_right_cancel (by simpa using congrArg f hab)) h

@[simp] theorem lift_of (f : SmoothRingHom A B) (hf : ∀ s, x s ≠ 0 → IsUnit (f s))
    (a : A) : lift x f hf (of x a) = f a := rfl

@[ext] theorem hom_ext {f g : SmoothRingHom (PointLocalization x) B}
    (h : ∀ a, f (of x a) = g (of x a)) : f = g :=
  (pointCongruence x).hom_ext h

/-- The residue morphism to the real numbers. -/
def residue : SmoothRingHom (PointLocalization x) ℝ :=
  lift x x fun _ hs => isUnit_iff_ne_zero.mpr hs

@[simp] theorem residue_of (a : A) : residue x (of x a) = x a := rfl

instance : Nontrivial (PointLocalization x) := (residue x).toAlgHom.toRingHom.domain_nontrivial

/-- Every element nonzero at the chosen point becomes a unit. -/
theorem isUnit_of (a : A) (ha : x a ≠ 0) : IsUnit (of x a) := by
  obtain ⟨f, g, hg, hfg⟩ := exists_localInverse (x a) ha
  have hxg : x (op g ![a]) ≠ 0 := by
    have h : x (op g ![a]) = 1 := by
      calc
        x (op g ![a]) = g ![x a] := by
          simp [Matrix.vec_single_eq_const]
        _ = 1 := hg
    rw [h]
    exact one_ne_zero
  have heq : (a * op f ![a] - 1) * op g ![a] = 0 := by
    have h := congrArg (fun h : SmoothOperation 1 => op h ![a]) hfg
    simpa using h
  have hrel : pointRelation x (a * op f ![a]) 1 := by
    refine ⟨op g ![a], hxg, ?_⟩
    simpa only [sub_mul, sub_eq_zero] using heq
  apply IsUnit.of_mul_eq_one (of x (op f ![a]))
  rw [← (of x).map_mul, ← (of x).map_one]
  exact (of_eq_of x _ _).mpr (.of hrel)

/-- The universal property includes existence and uniqueness. -/
theorem existsUnique_lift (f : SmoothRingHom A B)
    (hf : ∀ s, x s ≠ 0 → IsUnit (f s)) :
    ∃! g : SmoothRingHom (PointLocalization x) B, g.comp (of x) = f := by
  refine ⟨lift x f hf, rfl, fun g hg => ?_⟩
  apply hom_ext x
  intro a
  exact congrArg (fun h : SmoothRingHom A B => h a) hg

/-- Units are detected by the real residue. -/
theorem isUnit_iff (a : PointLocalization x) : IsUnit a ↔ residue x a ≠ 0 := by
  constructor
  · intro h
    exact ((h.map (residue x).toAlgHom.toRingHom).ne_zero)
  · obtain ⟨a, rfl⟩ := of_surjective x a
    exact isUnit_of x a

instance : IsLocalRing (PointLocalization x) :=
  IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun a => by
    by_cases ha : residue x a = 0
    · right
      apply (isUnit_iff x _).mpr
      change (residue x).toAlgHom (1 - a) ≠ 0
      rw [_root_.map_sub, _root_.map_one]
      change 1 - residue x a ≠ 0
      simp [ha]
    · exact Or.inl ((isUnit_iff x a).mpr ha)

instance : IsLocalHom (residue x).toAlgHom.toRingHom where
  map_nonunit a h := (isUnit_iff x a).mpr h.ne_zero

/-- The residue field is precisely ℝ, with its fixed real constants. -/
theorem residue_surjective : Function.Surjective (residue x) := fun r =>
  ⟨algebraMap ℝ (PointLocalization x) r, (residue x).map_algebraMap r⟩

/-- A smooth-ring morphism induces maps of point localizations. -/
def map (f : SmoothRingHom A B) (y : SmoothRingHom B ℝ) :
    SmoothRingHom (PointLocalization (y.comp f)) (PointLocalization y) :=
  lift (y.comp f) ((of y).comp f) fun a ha => isUnit_of y (f a) ha

@[simp] theorem map_of (f : SmoothRingHom A B) (y : SmoothRingHom B ℝ) (a : A) :
    map f y (of (y.comp f) a) = of y (f a) := rfl

@[simp] theorem residue_map (f : SmoothRingHom A B) (y : SmoothRingHom B ℝ)
    (a : PointLocalization (y.comp f)) : residue y (map f y a) = residue (y.comp f) a := by
  obtain ⟨a, rfl⟩ := of_surjective (y.comp f) a
  rfl

@[simp] theorem map_id (a : PointLocalization x) : map (SmoothRingHom.id A) x a = a := by
  obtain ⟨a, rfl⟩ := of_surjective x a
  rfl

@[simp] theorem map_comp (f : SmoothRingHom A B) (g : SmoothRingHom B C)
    (z : SmoothRingHom C ℝ) (a : PointLocalization (z.comp (g.comp f))) :
    map g z (map f (z.comp g) a) = map (g.comp f) z a := by
  obtain ⟨a, rfl⟩ := of_surjective (z.comp (g.comp f)) a
  rfl

instance (f : SmoothRingHom A B) (y : SmoothRingHom B ℝ) :
    IsLocalHom (map f y).toAlgHom.toRingHom where
  map_nonunit a ha := (isUnit_iff (y.comp f) a).mpr (by
    simpa using (isUnit_iff y (map f y a)).mp ha)

end PointLocalization
end ProjectAInos.SmoothAlgebra
