module

public import ProjectAInos.Thermodynamics.PhysicalComparison
public import ProjectAInos.Thermodynamics.Models
public import Mathlib.Data.Finsupp.SMul

/-!
# Composition conservation under generated accessibility

Starting from elementary processes that preserve system amounts, close the
relation under A1–A6. Conservation survives every closure operation, including
stability: equality of each amount coordinate passes to the vanishing-scale
limit. For formal composites of indexed atomic states, elementary processes
within one system automatically preserve the canonical composition label.
-/

@[expose] public section

open Filter
open scoped NNReal Topology

namespace ProjectAInos.Thermodynamics.Physical.Nonreactive

variable {X : Type*} [AddCommMonoid X] [DistribMulAction ℝ≥0 X]

/-- The relation generated by elementary processes and A1–A6. Splitting is
homogeneous; zero endpoints are permitted. -/
inductive Generated (elementary : X → X → Prop) : X → X → Prop
  | basic {x y} : elementary x y → Generated elementary x y
  | refl (x) : Generated elementary x x
  | trans {x y z} : Generated elementary x y → Generated elementary y z →
      Generated elementary x z
  | add {x y u v} : Generated elementary x y → Generated elementary u v →
      Generated elementary (x + u) (y + v)
  | scale (a : ℝ≥0) {x y} : Generated elementary x y →
      Generated elementary (a • x) (a • y)
  | split (a b : ℝ≥0) (x) :
      Generated elementary ((a + b) • x) (a • x + b • x)
  | recombine (a b : ℝ≥0) (x) :
      Generated elementary (a • x + b • x) ((a + b) • x)
  | stable (x y z₀ z₁ : X) (ε : ℕ → ℝ≥0)
      (hpos : ∀ n, 0 < ε n) (hlim : Tendsto ε atTop (𝓝 0)) :
      (∀ n, Generated elementary (x + ε n • z₀) (y + ε n • z₁)) →
      Generated elementary x y

/-- The generated relation supplies the full physical accessibility interface. -/
def generatedAccessibility (elementary : X → X → Prop)
    (hzero : ∀ x : X, (0 : ℝ≥0) • x = 0) : Accessibility X where
  relation := Generated elementary
  refl := Generated.refl
  trans := Generated.trans
  add_mono := Generated.add
  scale_mono := Generated.scale
  zero_scale := hzero
  split a b x := ⟨Generated.split a b x, Generated.recombine a b x⟩
  stable := Generated.stable

/-- Any A1–A6 relation containing the elementary processes contains their
generated closure. -/
theorem Generated.least {elementary : X → X → Prop} (P : Accessibility X)
    (hbasic : ∀ {x y}, elementary x y → P.relation x y)
    {x y : X} (h : Generated elementary x y) : P.relation x y := by
  induction h with
  | basic h => exact hbasic h
  | refl x => exact P.refl x
  | trans _ _ ih₁ ih₂ => exact P.trans ih₁ ih₂
  | add _ _ ih₁ ih₂ => exact P.add_mono ih₁ ih₂
  | scale a _ ih => exact P.scale_mono a ih
  | split a b x => exact (P.split a b x).1
  | recombine a b x => exact (P.split a b x).2
  | stable x y z₀ z₁ ε hpos hlim _ ih => exact P.stable x y z₀ z₁ ε hpos hlim ih

/-- An additive extensive real observable that increases on generators increases
on their full A1–A6 closure. No topology on the atomic states is needed. -/
theorem Generated.eval_le {elementary : X → X → Prop} (f : X →+ ℝ)
    (hscale : ∀ (r : ℝ≥0) x, f (r • x) = r • f x)
    (hbasic : ∀ {x y}, elementary x y → f x ≤ f y)
    {x y : X} (h : Generated elementary x y) : f x ≤ f y := by
  induction h with
  | basic h => exact hbasic h
  | refl => exact le_rfl
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | add _ _ ih₁ ih₂ => simpa only [map_add] using add_le_add ih₁ ih₂
  | scale r _ ih =>
    simpa only [hscale, NNReal.smul_def, smul_eq_mul] using
      mul_le_mul_of_nonneg_left ih r.coe_nonneg
  | split a b x => simp only [map_add, hscale, add_smul, le_refl]
  | recombine a b x => simp only [map_add, hscale, add_smul, le_refl]
  | stable x y z₀ z₁ ε _ hlim _ ih =>
    have he : Tendsto (fun n => (ε n : ℝ)) atTop (𝓝 0) :=
      NNReal.continuous_coe.tendsto 0 |>.comp hlim
    apply le_of_tendsto_of_tendsto'
      (by simpa using tendsto_const_nhds.add (he.mul_const (f z₀)))
      (by simpa using tendsto_const_nhds.add (he.mul_const (f z₁)))
    intro n
    simpa only [map_add, hscale, NNReal.smul_def, smul_eq_mul] using ih n

/-- Conservation of elementary system amounts survives the entire generated
relation. The stability case uses both inequalities in each amount coordinate. -/
theorem Generated.label_eq {Γ : Type*} {elementary : X → X → Prop}
    (label : X →+ (Γ →₀ ℝ≥0))
    (hscale : ∀ (r : ℝ≥0) (x : X), label (r • x) = r • label x)
    (hbasic : ∀ {x y}, elementary x y → label x = label y)
    {x y : X} (h : Generated elementary x y) : label x = label y := by
  induction h with
  | basic h => exact hbasic h
  | refl => rfl
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | add _ _ ih₁ ih₂ => simp only [map_add, ih₁, ih₂]
  | scale a _ ih => simp only [hscale, ih]
  | split a b x => simp only [map_add, hscale, add_smul]
  | recombine a b x => simp only [map_add, hscale, add_smul]
  | stable x y z₀ z₁ ε hpos hlim _ ih =>
    ext g
    have heq (n : ℕ) : label x g + ε n * label z₀ g = label y g + ε n * label z₁ g := by
      simpa only [map_add, hscale, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul] using
        congrArg (fun v : Γ →₀ ℝ≥0 => v g) (ih n)
    exact le_antisymm
      (nnreal_stability (label x g) (label y g) (label z₀ g) (label z₁ g)
        ε hpos hlim (fun n => (heq n).le))
      (nnreal_stability (label y g) (label x g) (label z₁ g) (label z₀ g)
        ε hpos hlim (fun n => (heq n).ge))

variable {Γ : Type*} (State : Γ → Type*)

/-- One unscaled atom has unit amount of its own system type. -/
noncomputable def atomCompositionLabel (x : Σ g, State g) : Γ →₀ ℝ≥0 :=
  Finsupp.single x.1 1

/-- The finitely supported system amounts of a coherent finite composite. -/
noncomputable def compositionLabel : CompositeState (Σ g, State g) →+ (Γ →₀ ℝ≥0) :=
  CompositeState.label (atomCompositionLabel State)

@[simp] theorem compositionLabel_atom (g : Γ) (x : State g) :
    compositionLabel State (CompositeState.mk (.atom ⟨g, x⟩)) = Finsupp.single g 1 := rfl

@[simp] theorem compositionLabel_scale (r : ℝ≥0) (x : CompositeState (Σ g, State g)) :
    compositionLabel State (r • x) = r • compositionLabel State x :=
  CompositeState.label_scale _ r x

/-- Elementary transformations replace one atom by another state of the same
system. Composition and scaling are added by `Generated`. -/
inductive SameSystemStep (elementary : ∀ g, State g → State g → Prop) :
    CompositeState (Σ g, State g) → CompositeState (Σ g, State g) → Prop
  | atom {g} {x y : State g} : elementary g x y →
      SameSystemStep elementary (CompositeState.mk (.atom ⟨g, x⟩))
        (CompositeState.mk (.atom ⟨g, y⟩))

theorem SameSystemStep.label_eq {elementary : ∀ g, State g → State g → Prop}
    {x y : CompositeState (Σ g, State g)} (h : SameSystemStep State elementary x y) :
    compositionLabel State x = compositionLabel State y := by
  cases h
  rfl

/-- The reaction-free accessibility relation generated from within-system
atomic transformations, with all A1–A6 closure operations. -/
def accessibility (elementary : ∀ g, State g → State g → Prop) :
    Accessibility (CompositeState (Σ g, State g)) :=
  generatedAccessibility (SameSystemStep State elementary) CompositeState.zero_scale

/-- Full generated accessibility preserves every system amount; preservation
is proved rather than assumed for the generated relation. -/
theorem accessibility_label_eq (elementary : ∀ g, State g → State g → Prop)
    {x y : CompositeState (Σ g, State g)} (h : (accessibility State elementary).relation x y) :
    compositionLabel State x = compositionLabel State y :=
  Generated.label_eq (compositionLabel State) (compositionLabel_scale State)
    (SameSystemStep.label_eq State) h

/-- The canonical composition label on adiabatic classes of nonreactive
composites. -/
noncomputable def sectorLabel (elementary : ∀ g, State g → State g → Prop) :
    (accessibility State elementary).StateSpace →+ (Γ →₀ ℝ≥0) :=
  (accessibility State elementary).sectorLabel (compositionLabel State)
    (accessibility_label_eq State elementary)

end ProjectAInos.Thermodynamics.Physical.Nonreactive
