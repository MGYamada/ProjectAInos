module

public import ProjectAInos.Thermodynamics.Completion
public import ProjectAInos.Thermodynamics.Comparison
public import ProjectAInos.Thermodynamics.Representation
public import Mathlib.Tactic.Abel

/-!
# The cone of accessible processes

Order reflection transfers the original stability hypothesis to the completion.
Exchange comparison then gives totality on the span of process differences.
-/

@[expose] public section

open Filter
open scoped NNReal Topology

namespace ProjectAInos.Thermodynamics

variable {M : Type*} [AddCommMonoid M] [PartialOrder M] [Module ℝ≥0 M]
  [IsOrderedAddMonoid M] [PosSMulMono ℝ≥0 M]

open Completion

/-- Positive formal differences are precisely the accessible processes. -/
noncomputable def processCone (M : Type*) [AddCommMonoid M] [PartialOrder M]
    [Module ℝ≥0 M] [IsOrderedAddMonoid M] [PosSMulMono ℝ≥0 M] :
    PointedCone ℝ (Completion M) where
  carrier := {v | ∃ x y : M, x ≤ y ∧ v = of y - of x}
  zero_mem' := ⟨0, 0, le_rfl, by simp⟩
  add_mem' := by
    rintro v w ⟨x, y, hxy, rfl⟩ ⟨a, b, hab, rfl⟩
    exact ⟨x + a, y + b, add_le_add hxy hab, by simp; abel⟩
  smul_mem' := by
    rintro r v ⟨x, y, hxy, rfl⟩
    let a : ℝ≥0 := ⟨r, r.property⟩
    refine ⟨a • x, a • y, smul_le_smul_of_nonneg_left hxy (show 0 ≤ a from bot_le), ?_⟩
    change (a : ℝ) • (of y - of x) = of (a • y) - of (a • x)
    simp only [of_nnreal_smul, NNReal.smul_def, smul_sub]

/-- The vector space generated by accessible process differences. -/
noncomputable abbrev processSpan (M : Type*) [AddCommMonoid M] [PartialOrder M]
    [Module ℝ≥0 M] [IsOrderedAddMonoid M] [PosSMulMono ℝ≥0 M] :=
  Submodule.span ℝ (processCone M : Set (Completion M))

/-- Stability makes the process cone reflect the original accessibility order. -/
theorem processCone_reflects (hS : Stability M) (x y : M) :
    of y - of x ∈ processCone M ↔ x ≤ y := by
  constructor
  · rintro ⟨a, b, hab, heq⟩
    have hsum : y + a = x + b := by
      apply of_injective hS
      simp only [map_add]
      apply sub_eq_zero.mp
      calc
        (of y + of a) - (of x + of b) = (of y - of x) - (of b - of a) := by abel
        _ = 0 := sub_eq_zero.mpr heq
    apply hS.le_of_add_le_add_right (z := a)
    calc
      x + a ≤ x + b := by simpa only [add_comm x] using add_le_add_left hab x
      _ = y + a := hsum.symm
  · intro hxy
    exact ⟨x, y, hxy, rfl⟩

/-- Passing to adiabatic equivalence and proving cancellation removes the
lineality of the cone. -/
theorem processCone_salient (hS : Stability M) :
    (processCone M : ConvexCone ℝ (Completion M)).Salient := by
  rintro v ⟨x, y, hxy, rfl⟩ hne hneg
  have hyx : y ≤ x := (processCone_reflects hS y x).mp (by simpa using hneg)
  exact hne (by simp [le_antisymm hxy hyx])

/-- The accessibility cone gives the completion a partial order. -/
@[instance_reducible]
noncomputable def completionPartialOrder (hS : Stability M) : PartialOrder (Completion M) :=
  (processCone M).toConvexCone.toPartialOrder (processCone M).zero_mem
    (processCone_salient hS)

/-- Translation preserves the order induced by the process cone. -/
theorem completion_isOrderedAddMonoid (hS : Stability M) :
    letI := completionPartialOrder hS
    IsOrderedAddMonoid (Completion M) :=
  (processCone M).toConvexCone.to_isOrderedAddMonoid (processCone M).zero_mem
    (processCone_salient hS)

/-- The inclusion preserves and reflects accessibility in the completion order. -/
theorem completion_of_le_iff (hS : Stability M) (x y : M) :
    letI := completionPartialOrder hS
    of x ≤ of y ↔ x ≤ y := processCone_reflects hS x y

/-- Stability on states implies closure along vanishing perturbations in the
completion, with no topology required on that completion. -/
theorem processCone_sequentialOrderClosed (hS : Stability M) :
    SequentialOrderClosed (processCone M) := by
  intro v w ε hpos hlim h
  obtain ⟨y, x, rfl⟩ := exists_sub_of v
  obtain ⟨z₁, z₀, rfl⟩ := exists_sub_of w
  apply (processCone_reflects hS x y).mpr
  apply hS x y z₀ z₁ ε hpos hlim
  intro n
  apply (processCone_reflects hS _ _).mp
  have heq : of (y + ε n • z₁) - of (x + ε n • z₀) =
      of y - of x + (ε n : ℝ) • (of z₁ - of z₀) := by
    simp only [map_add, of_nnreal_smul, NNReal.smul_def, smul_sub]
    abel
  rw [heq]
  exact h n

/-- Exchange comparison is exactly totality on the space of process differences. -/
theorem exchangeComparison_iff_coneTotal (hS : Stability M) :
    ExchangeComparison M ↔ ConeTotalOnSpan (processCone M) := by
  constructor
  · intro h w hw
    obtain ⟨p, ⟨x, y, hxy, rfl⟩, q, ⟨u, v, huv, rfl⟩, rfl⟩ :=
      (processCone M).mem_span.mp hw
    have heq : (of y - of x) - (of v - of u) =
        of (y + u) - of (x + v) := by simp only [map_add]; abel
    rw [heq]
    rcases h x y u v hxy huv with h | h
    · exact Or.inl ((processCone_reflects hS _ _).mpr h)
    · exact Or.inr (by simpa using (processCone_reflects hS _ _).mpr h)
  · intro h x y u v hxy huv
    have hp : of y - of x ∈ processCone M := ⟨x, y, hxy, rfl⟩
    have hq : of v - of u ∈ processCone M := ⟨u, v, huv, rfl⟩
    have hw : of (y + u) - of (x + v) ∈ processSpan M := by
      have heq : of (y + u) - of (x + v) =
          (of y - of x) - (of v - of u) := by simp only [map_add]; abel
      rw [heq]
      exact Submodule.sub_mem _ (Submodule.subset_span hp) (Submodule.subset_span hq)
    rcases h _ hw with h | h
    · exact Or.inl ((processCone_reflects hS _ _).mp h)
    · exact Or.inr ((processCone_reflects hS _ _).mp (by simpa using h))

end ProjectAInos.Thermodynamics
