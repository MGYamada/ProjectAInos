module

public import ProjectAInos.Mechanics.Jet.Basic
public import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic.Ring

/-!
# Euler operators, null Lagrangians and conserved elements

The Euler operator `Eᵢ = Σₖ (−D)ᵏ ∂ᵢ⁽ᵏ⁾` is a finite sum on every element of a
jet ring. Total derivatives are null Lagrangians: `Eᵢ (D F) = 0` for every `F`,
of any order. The proof is a telescoping sum built from `[∂ᵢ⁽ᵏ⁺¹⁾, D] = ∂ᵢ⁽ᵏ⁾`.

The Euler–Lagrange ideal of `L` is generated by all total derivatives of the
`Eᵢ(L)`. It is stable under `D`, and an element is conserved when its total
derivative lies in it. No path, integral or limit appears.
-/

@[expose] public section

noncomputable section

namespace ProjectAInos.Mechanics.JetRing

open SmoothAlgebra

variable {ι J : Type*} [CommRing J] [Algebra ℝ J] [SmoothRing J] [Fintype ι] (R : JetRing ι J)

/-- The Euler operator `Eᵢ = Σₖ (−D)ᵏ ∂ᵢ⁽ᵏ⁾`. -/
def euler (i : ι) (F : J) : J :=
  ∑ᶠ k : ℕ, (-1 : J) ^ k * (R.totalDeriv^[k]) (R.d i k F)

variable {R}

theorem euler_eq_sum {F : J} {N : ℕ} (h : R.OrderLE F N) (i : ι) :
    R.euler i F =
      ∑ k ∈ Finset.range (N + 1), (-1 : J) ^ k * (R.totalDeriv^[k]) (R.d i k F) := by
  apply finsum_eq_sum_of_support_subset
  intro k hk
  rw [Function.mem_support] at hk
  rw [Finset.coe_range, Set.mem_Iio]
  by_contra hlt
  apply hk
  rw [h i k (by omega), iterate_map_zero, mul_zero]

/-- Total derivatives are null Lagrangians: `Eᵢ ∘ D = 0` (Landau–Lifshitz §2). -/
theorem euler_totalDeriv (i : ι) (F : J) : R.euler i (R.totalDeriv F) = 0 := by
  obtain ⟨N, hN⟩ := R.exists_orderLE F
  let b : ℕ → J := fun k => (-1 : J) ^ k * (R.totalDeriv^[k + 1]) (R.d i k F)
  have hterm (m : ℕ) :
      (-1 : J) ^ (m + 1) * (R.totalDeriv^[m + 1]) (R.d i (m + 1) (R.totalDeriv F)) =
        b (m + 1) - b m := by
    rw [d_succ_totalDeriv, iterate_map_add, ← Function.iterate_succ_apply]
    simp only [b]
    ring
  have hzero : (-1 : J) ^ 0 * (R.totalDeriv^[0]) (R.d i 0 (R.totalDeriv F)) = b 0 := by
    rw [d_zero_totalDeriv]
    rfl
  rw [euler_eq_sum hN.totalDeriv i, Finset.sum_range_succ', hzero,
    Finset.sum_congr rfl fun m _ => hterm m, Finset.sum_range_sub, sub_add_cancel]
  simp only [b]
  rw [hN i (N + 1) (by omega), iterate_map_zero, mul_zero]

/-- Adding a total derivative does not change the Euler–Lagrange expressions. -/
theorem euler_add_totalDeriv (i : ι) (L F : J) :
    R.euler i (L + R.totalDeriv F) = R.euler i L := by
  obtain ⟨N, hN⟩ := R.exists_orderLE L
  obtain ⟨M, hM⟩ := R.exists_orderLE (R.totalDeriv F)
  have hL := hN.mono (le_max_left N M)
  have hF := hM.mono (le_max_right N M)
  have h : R.euler i (R.totalDeriv F) = 0 := euler_totalDeriv i F
  rw [euler_eq_sum hF] at h
  rw [euler_eq_sum (hL.add hF), euler_eq_sum hL]
  simp only [map_add, iterate_map_add, mul_add, Finset.sum_add_distrib, h, add_zero]

variable (R)

/-- The Euler–Lagrange ideal, generated by all total derivatives of the
Euler–Lagrange expressions. -/
def eulerLagrangeIdeal (L : J) : Ideal J :=
  Ideal.span {x | ∃ i k, x = (R.totalDeriv^[k]) (R.euler i L)}

/-- `F` is conserved for the Lagrangian `L`: its total derivative lies in the
Euler–Lagrange ideal. -/
def Conserved (L F : J) : Prop := R.totalDeriv F ∈ R.eulerLagrangeIdeal L

variable {R}

theorem iterate_totalDeriv_euler_mem (L : J) (i : ι) (k : ℕ) :
    (R.totalDeriv^[k]) (R.euler i L) ∈ R.eulerLagrangeIdeal L :=
  Ideal.subset_span ⟨i, k, rfl⟩

theorem euler_mem (L : J) (i : ι) : R.euler i L ∈ R.eulerLagrangeIdeal L :=
  iterate_totalDeriv_euler_mem L i 0

/-- The Euler–Lagrange ideal is stable under the total derivative. -/
theorem totalDeriv_mem_eulerLagrangeIdeal {L x : J} (hx : x ∈ R.eulerLagrangeIdeal L) :
    R.totalDeriv x ∈ R.eulerLagrangeIdeal L := by
  refine Submodule.span_induction (p := fun x _ => R.totalDeriv x ∈ R.eulerLagrangeIdeal L)
    ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨i, k, rfl⟩
    have hk : R.totalDeriv ((R.totalDeriv^[k]) (R.euler i L)) =
        (R.totalDeriv^[k + 1]) (R.euler i L) :=
      (Function.iterate_succ_apply' _ _ _).symm
    rw [hk]
    exact iterate_totalDeriv_euler_mem L i (k + 1)
  · rw [map_zero]
    exact zero_mem _
  · intro x y _ _ hx hy
    rw [map_add]
    exact add_mem hx hy
  · intro a x hx hDx
    rw [smul_eq_mul, SmoothDerivation.map_mul, smul_eq_mul, smul_eq_mul]
    exact add_mem (Ideal.mul_mem_left _ a hDx) (Ideal.mul_mem_right _ _ hx)

/-- A conserved element stays conserved after any number of total derivatives. -/
theorem Conserved.totalDeriv {L F : J} (h : R.Conserved L F) :
    R.Conserved L (R.totalDeriv F) :=
  totalDeriv_mem_eulerLagrangeIdeal h

/-- Elements with vanishing total derivative are conserved for every Lagrangian. -/
theorem conserved_of_totalDeriv_eq_zero {F : J} (L : J) (h : R.totalDeriv F = 0) :
    R.Conserved L F := by
  rw [Conserved, h]
  exact zero_mem _

end ProjectAInos.Mechanics.JetRing
