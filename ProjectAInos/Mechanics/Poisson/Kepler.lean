module

public import ProjectAInos.Mechanics.Poisson.Epsilon
public import ProjectAInos.SmoothAlgebra.Poisson.Ideal
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-!
# Kepler's problem and the Runge–Lenz vector

A Kepler frame in a Poisson C-infinity ring consists of positions `q`, momenta
`p` with the canonical brackets, and an element `ρ` with the brackets of the
inverse distance, `{ρ, qⱼ} = 0` and `{ρ, pⱼ} = −ρ³ qⱼ`. The relation
`ρ² |q|² = 1` is not assumed: it is the element `constraint = ρ² |q|² − 1`, and
the statements below say exactly how each identity depends on it
(Landau–Lifshitz §15, Proposition 69 of the research plan).

With `H = |p|² / 2m − α ρ`, `M = q × p`, `A = p × M − m α ρ q` and
`r = ρ |q|²`:

* `{Mₐ, H} = 0` and `{Mₐ, A_b} = εₐ_bc A_c`, `A · M = 0`, `A · q = |M|² − m α r`
  hold exactly;
* `{Aₐ, H}`, `{Aₐ, A_b} + 2 m H εₐ_bc M_c` and
  `|A|² − (m² α² + 2 m H |M|²)` are explicit multiples of the constraint.

The ideal generated by the constraint is a Poisson ideal, so these are
identities on the locus where `ρ` is the inverse distance.
-/

@[expose] public section

noncomputable section

namespace ProjectAInos.Mechanics.Kepler

open SmoothAlgebra SmoothRing Matrix

variable {P : Type*} [CommRing P] [Algebra ℝ P] [SmoothRing P]

/-- Positions `q`, momenta `p` and an inverse distance `ρ`: the canonical
brackets, and the brackets that `ρ = 1 / |q|` satisfies. -/
structure IsFrame (π : PoissonStructure P) (q p : Fin 3 → P) (ρ : P) : Prop where
  q_q : ∀ i j, π.bracket (q i) (q j) = 0
  p_p : ∀ i j, π.bracket (p i) (p j) = 0
  q_p : ∀ i j, π.bracket (q i) (p j) = if i = j then 1 else 0
  ρ_q : ∀ j, π.bracket ρ (q j) = 0
  ρ_p : ∀ j, π.bracket ρ (p j) = -(ρ * ρ * ρ * q j)

/-- The angular momentum `M = q × p`. -/
def angularMomentum (q p : Fin 3 → P) : Fin 3 → P := q ⨯₃ p

/-- The Hamiltonian `|p|² / 2m − α ρ`. -/
def hamiltonian (m α : ℝ) (p : Fin 3 → P) (ρ : P) : P :=
  algebraMap ℝ P (m⁻¹ / 2) * (p ⬝ᵥ p) - algebraMap ℝ P α * ρ

/-- The Runge–Lenz vector `A = p × M − m α ρ q`. -/
def rungeLenz (m α : ℝ) (q p : Fin 3 → P) (ρ : P) : Fin 3 → P :=
  fun a => (p ⨯₃ angularMomentum q p) a - algebraMap ℝ P m * algebraMap ℝ P α * (ρ * q a)

/-- The constraint `ρ² |q|² − 1`, which vanishes where `ρ` is the inverse distance. -/
def constraint (q : Fin 3 → P) (ρ : P) : P := ρ * ρ * (q ⬝ᵥ q) - 1

/-- The distance `r = ρ |q|²`. -/
def distance (q : Fin 3 → P) (ρ : P) : P := ρ * (q ⬝ᵥ q)

omit [Algebra ℝ P] [SmoothRing P] in
/-- `ρ r = 1` up to the constraint. -/
theorem ρ_mul_distance (q : Fin 3 → P) (ρ : P) : ρ * distance q ρ = 1 + constraint q ρ := by
  rw [distance, constraint]
  ring

omit [Algebra ℝ P] [SmoothRing P] in
/-- `r² = |q|²` up to the constraint. -/
theorem distance_mul_distance (q : Fin 3 → P) (ρ : P) :
    distance q ρ * distance q ρ = (q ⬝ᵥ q) + (q ⬝ᵥ q) * constraint q ρ := by
  rw [distance, constraint]
  ring

omit [SmoothRing P] in
theorem two_mul_algebraMap_half (m : ℝ) :
    2 * algebraMap ℝ P (m⁻¹ / 2) = algebraMap ℝ P m⁻¹ := by
  have h2 : (2 : P) = algebraMap ℝ P 2 := (map_ofNat _ 2).symm
  rw [h2, ← map_mul]
  congr 1
  ring

omit [SmoothRing P] in
theorem algebraMap_mul_inv {m : ℝ} (hm : m ≠ 0) :
    algebraMap ℝ P m * algebraMap ℝ P m⁻¹ = 1 := by
  rw [← map_mul, mul_inv_cancel₀ hm, map_one]

omit [SmoothRing P] in
/-- `A · M = 0`: the Runge–Lenz vector lies in the plane of the orbit. -/
theorem rungeLenz_dotProduct_angularMomentum (m α : ℝ) (q p : Fin 3 → P) (ρ : P) :
    rungeLenz m α q p ρ ⬝ᵥ angularMomentum q p = 0 := by
  simp only [dotProduct, Fin.sum_univ_three, rungeLenz, angularMomentum, cross_apply,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  ring

omit [SmoothRing P] in
/-- The orbit identity `A · q = |M|² − m α r`, the equation of a conic. -/
theorem rungeLenz_dotProduct_q (m α : ℝ) (q p : Fin 3 → P) (ρ : P) :
    rungeLenz m α q p ρ ⬝ᵥ q =
      angularMomentum q p ⬝ᵥ angularMomentum q p -
        algebraMap ℝ P m * algebraMap ℝ P α * distance q ρ := by
  simp only [dotProduct, Fin.sum_univ_three, rungeLenz, angularMomentum, distance, cross_apply,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  ring

omit [SmoothRing P] in
/-- `|A|² = m² α² + 2 m H |M|²` up to the constraint. -/
theorem rungeLenz_dotProduct_self {m : ℝ} (hm : m ≠ 0) (α : ℝ) (q p : Fin 3 → P) (ρ : P) :
    rungeLenz m α q p ρ ⬝ᵥ rungeLenz m α q p ρ =
      algebraMap ℝ P m * algebraMap ℝ P m * (algebraMap ℝ P α * algebraMap ℝ P α) +
        2 * algebraMap ℝ P m * hamiltonian m α p ρ *
          (angularMomentum q p ⬝ᵥ angularMomentum q p) +
        algebraMap ℝ P m * algebraMap ℝ P m * (algebraMap ℝ P α * algebraMap ℝ P α) *
          constraint q ρ := by
  have hh := two_mul_algebraMap_half (P := P) m
  have hmm := algebraMap_mul_inv (P := P) hm
  simp only [dotProduct, Fin.sum_univ_three, rungeLenz, angularMomentum, hamiltonian, constraint,
    cross_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons]
  linear_combination
    (-(algebraMap ℝ P m * (p 0 * p 0 + p 1 * p 1 + p 2 * p 2) *
      ((q 1 * p 2 - q 2 * p 1) * (q 1 * p 2 - q 2 * p 1) +
        (q 2 * p 0 - q 0 * p 2) * (q 2 * p 0 - q 0 * p 2) +
        (q 0 * p 1 - q 1 * p 0) * (q 0 * p 1 - q 1 * p 0)))) * hh +
    (-((p 0 * p 0 + p 1 * p 1 + p 2 * p 2) *
      ((q 1 * p 2 - q 2 * p 1) * (q 1 * p 2 - q 2 * p 1) +
        (q 2 * p 0 - q 0 * p 2) * (q 2 * p 0 - q 0 * p 2) +
        (q 0 * p 1 - q 1 * p 0) * (q 0 * p 1 - q 1 * p 0)))) * hmm

section Naturality

variable {Q : Type*} [CommRing Q] [Algebra ℝ Q] [SmoothRing Q] (φ : SmoothRingHom P Q)

/-- A morphism of C-infinity rings maps the angular momentum to the angular
momentum of the images. -/
theorem map_angularMomentum (q p : Fin 3 → P) (a : Fin 3) :
    φ (angularMomentum q p a) = angularMomentum (fun i => φ (q i)) (fun i => φ (p i)) a := by
  fin_cases a <;>
    simp [angularMomentum, cross_apply, SmoothRingHom.map_sub, SmoothRingHom.map_mul]

theorem map_hamiltonian (m α : ℝ) (p : Fin 3 → P) (ρ : P) :
    φ (hamiltonian m α p ρ) = hamiltonian m α (fun i => φ (p i)) (φ ρ) := by
  simp only [hamiltonian, dotProduct, SmoothRingHom.map_sub, SmoothRingHom.map_mul,
    SmoothRingHom.map_algebraMap, SmoothRingHom.map_sum]

theorem map_constraint (q : Fin 3 → P) (ρ : P) :
    φ (constraint q ρ) = constraint (fun i => φ (q i)) (φ ρ) := by
  simp only [constraint, dotProduct, SmoothRingHom.map_sub, SmoothRingHom.map_mul,
    SmoothRingHom.map_one, SmoothRingHom.map_sum]

theorem map_rungeLenz (m α : ℝ) (q p : Fin 3 → P) (ρ : P) (a : Fin 3) :
    φ (rungeLenz m α q p ρ a) =
      rungeLenz m α (fun i => φ (q i)) (fun i => φ (p i)) (φ ρ) a := by
  have hM (c : Fin 3) := map_angularMomentum φ q p c
  fin_cases a <;>
    simp [rungeLenz, cross_apply, SmoothRingHom.map_sub, SmoothRingHom.map_mul, hM]

end Naturality

namespace IsFrame

variable {π : PoissonStructure P} {q p : Fin 3 → P} {ρ : P}

theorem p_q (h : IsFrame π q p ρ) (i j : Fin 3) :
    π.bracket (p i) (q j) = if i = j then -1 else 0 := by
  rw [π.antisymm, h.q_p]
  split_ifs with h1 h2 h2
  · rfl
  · exact absurd h1.symm h2
  · exact absurd h2.symm h1
  · exact neg_zero

theorem q_ρ (h : IsFrame π q p ρ) (j : Fin 3) : π.bracket (q j) ρ = 0 := by
  rw [π.antisymm, h.ρ_q, neg_zero]

theorem p_ρ (h : IsFrame π q p ρ) (j : Fin 3) : π.bracket (p j) ρ = ρ * ρ * ρ * q j := by
  rw [π.antisymm, h.ρ_p, neg_neg]

/-- `{Mₐ, q_b} = εₐ_bc q_c`. -/
theorem angularMomentum_q (h : IsFrame π q p ρ) (a b : Fin 3) :
    π.bracket (angularMomentum q p a) (q b) = epsilon q a b := by
  fin_cases a <;> fin_cases b <;>
    simp [angularMomentum, epsilon, cross_apply, AlmostPoissonStructure.bracket_sub_left,
      AlmostPoissonStructure.bracket_mul_left, h.q_q, h.p_q]

/-- `{Mₐ, p_b} = εₐ_bc p_c`. -/
theorem angularMomentum_p (h : IsFrame π q p ρ) (a b : Fin 3) :
    π.bracket (angularMomentum q p a) (p b) = epsilon p a b := by
  fin_cases a <;> fin_cases b <;>
    simp [angularMomentum, epsilon, cross_apply, AlmostPoissonStructure.bracket_sub_left,
      AlmostPoissonStructure.bracket_mul_left, h.p_p, h.q_p]

/-- The inverse distance is invariant under rotations: `{Mₐ, ρ} = 0`. -/
theorem angularMomentum_ρ (h : IsFrame π q p ρ) (a : Fin 3) :
    π.bracket (angularMomentum q p a) ρ = 0 := by
  fin_cases a <;>
    simp [angularMomentum, cross_apply, AlmostPoissonStructure.bracket_sub_left,
      AlmostPoissonStructure.bracket_mul_left, h.q_ρ, h.p_ρ] <;>
    ring

/-- `{Mₐ, M_b} = εₐ_bc M_c`. -/
theorem angularMomentum_angularMomentum (h : IsFrame π q p ρ) (a b : Fin 3) :
    π.bracket (angularMomentum q p a) (angularMomentum q p b) =
      epsilon (angularMomentum q p) a b := by
  fin_cases a <;> fin_cases b <;>
    simp [angularMomentum, epsilon, cross_apply, AlmostPoissonStructure.bracket_sub_left,
      AlmostPoissonStructure.bracket_mul_left, AlmostPoissonStructure.bracket_sub_right,
      AlmostPoissonStructure.bracket_mul_right, h.q_q, h.p_p, h.q_p, h.p_q] <;>
    ring

/-- Hamilton's equation `{q, H} = p / m`. -/
theorem q_hamiltonian (h : IsFrame π q p ρ) (m α : ℝ) (a : Fin 3) :
    π.bracket (q a) (hamiltonian m α p ρ) = algebraMap ℝ P m⁻¹ * p a := by
  have hh := two_mul_algebraMap_half (P := P) m
  simp only [hamiltonian, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_algebraMap_right,
    h.q_p, h.q_ρ]
  fin_cases a
  · simp
    linear_combination (p 0) * hh
  · simp
    linear_combination (p 1) * hh
  · simp
    linear_combination (p 2) * hh

/-- Hamilton's equation `{p, H} = −α ρ³ q`, the inverse-square force. -/
theorem p_hamiltonian (h : IsFrame π q p ρ) (m α : ℝ) (a : Fin 3) :
    π.bracket (p a) (hamiltonian m α p ρ) = -(algebraMap ℝ P α * (ρ * ρ * ρ * q a)) := by
  simp only [hamiltonian, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_algebraMap_right,
    h.p_p, h.p_ρ]
  ring

/-- `{ρ, H} = −ρ³ (q · p) / m`. -/
theorem ρ_hamiltonian (h : IsFrame π q p ρ) (m α : ℝ) :
    π.bracket ρ (hamiltonian m α p ρ) =
      -(algebraMap ℝ P m⁻¹ * (ρ * ρ * ρ) * (q ⬝ᵥ p)) := by
  have hh := two_mul_algebraMap_half (P := P) m
  simp only [hamiltonian, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_algebraMap_right,
    AlmostPoissonStructure.bracket_self, h.ρ_p]
  linear_combination (-(ρ * ρ * ρ * (q 0 * p 0 + q 1 * p 1 + q 2 * p 2))) * hh

/-- The angular momentum is an integral of the motion: `{Mₐ, H} = 0`. -/
theorem angularMomentum_hamiltonian (h : IsFrame π q p ρ) (m α : ℝ) (a : Fin 3) :
    π.bracket (angularMomentum q p a) (hamiltonian m α p ρ) = 0 := by
  simp only [hamiltonian, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_algebraMap_right,
    h.angularMomentum_p, h.angularMomentum_ρ]
  fin_cases a <;> simp [epsilon] <;> ring

/-- `{q, constraint} = 0`. -/
theorem q_constraint (h : IsFrame π q p ρ) (a : Fin 3) :
    π.bracket (q a) (constraint q ρ) = 0 := by
  simp only [constraint, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_one_right,
    h.q_q, h.q_ρ]
  ring

/-- `{ρ, constraint} = 0`. -/
theorem ρ_constraint (h : IsFrame π q p ρ) : π.bracket ρ (constraint q ρ) = 0 := by
  simp only [constraint, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_one_right,
    AlmostPoissonStructure.bracket_self, h.ρ_q]
  ring

/-- `{p, constraint} = 2 ρ² q · constraint`: the constraint generates a Poisson
ideal. -/
theorem p_constraint (h : IsFrame π q p ρ) (a : Fin 3) :
    π.bracket (p a) (constraint q ρ) = 2 * (ρ * ρ) * q a * constraint q ρ := by
  simp only [constraint, dotProduct, Fin.sum_univ_three,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_right,
    AlmostPoissonStructure.bracket_add_right, AlmostPoissonStructure.bracket_one_right,
    h.p_q, h.p_ρ]
  fin_cases a <;> simp <;> ring

/-- The Runge–Lenz vector is conserved up to the constraint (Landau–Lifshitz
§15): `{Aₐ, H} = α ρ pₐ · constraint`. -/
theorem rungeLenz_hamiltonian (h : IsFrame π q p ρ) {m : ℝ} (hm : m ≠ 0) (α : ℝ) (a : Fin 3) :
    π.bracket (rungeLenz m α q p ρ a) (hamiltonian m α p ρ) =
      algebraMap ℝ P α * ρ * p a * constraint q ρ := by
  have hmm := algebraMap_mul_inv (P := P) hm
  have hq (c : Fin 3) := h.q_hamiltonian m α c
  have hp (c : Fin 3) := h.p_hamiltonian m α c
  have hρ := h.ρ_hamiltonian m α
  have hM (c : Fin 3) := h.angularMomentum_hamiltonian m α c
  have hA : π.bracket (rungeLenz m α q p ρ a) (hamiltonian m α p ρ) =
      π.bracket ((p ⨯₃ angularMomentum q p) a -
        algebraMap ℝ P m * algebraMap ℝ P α * (ρ * q a)) (hamiltonian m α p ρ) := rfl
  rw [hA]
  fin_cases a
  · simp only [cross_apply, Matrix.cons_val_zero, Fin.zero_eta,
      AlmostPoissonStructure.bracket_sub_left, AlmostPoissonStructure.bracket_mul_left,
      AlmostPoissonStructure.bracket_algebraMap_left, hq, hp, hρ, hM, mul_zero, add_zero]
    simp only [angularMomentum, constraint, dotProduct, Fin.sum_univ_three, cross_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons]
    linear_combination (algebraMap ℝ P α * ρ *
      (ρ * ρ * q 0 * (q 0 * p 0 + q 1 * p 1 + q 2 * p 2) - p 0)) * hmm
  · simp only [cross_apply, Matrix.cons_val_one, Matrix.cons_val_zero, Fin.mk_one,
      AlmostPoissonStructure.bracket_sub_left, AlmostPoissonStructure.bracket_mul_left,
      AlmostPoissonStructure.bracket_algebraMap_left, hq, hp, hρ, hM, mul_zero, add_zero]
    simp only [angularMomentum, constraint, dotProduct, Fin.sum_univ_three, cross_apply,
      Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    linear_combination (algebraMap ℝ P α * ρ *
      (ρ * ρ * q 1 * (q 0 * p 0 + q 1 * p 1 + q 2 * p 2) - p 1)) * hmm
  · simp only [cross_apply, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons,
      Fin.reduceFinMk, AlmostPoissonStructure.bracket_sub_left,
      AlmostPoissonStructure.bracket_mul_left, AlmostPoissonStructure.bracket_algebraMap_left,
      hq, hp, hρ, hM, mul_zero, add_zero]
    simp only [angularMomentum, constraint, dotProduct, Fin.sum_univ_three, cross_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one]
    linear_combination (algebraMap ℝ P α * ρ *
      (ρ * ρ * q 2 * (q 0 * p 0 + q 1 * p 1 + q 2 * p 2) - p 2)) * hmm

/-- The Runge–Lenz vector transforms as a vector under rotations:
`{Mₐ, A_b} = εₐ_bc A_c`. -/
theorem angularMomentum_rungeLenz (h : IsFrame π q p ρ) (m α : ℝ) (a b : Fin 3) :
    π.bracket (angularMomentum q p a) (rungeLenz m α q p ρ b) =
      epsilon (rungeLenz m α q p ρ) a b := by
  fin_cases a <;> fin_cases b <;>
    simp [rungeLenz, epsilon, cross_apply, AlmostPoissonStructure.bracket_sub_right,
      AlmostPoissonStructure.bracket_mul_right, h.angularMomentum_p,
      h.angularMomentum_angularMomentum, h.angularMomentum_ρ, h.angularMomentum_q] <;>
    ring

theorem rungeLenz_zero_rungeLenz_one (h : IsFrame π q p ρ) {m : ℝ} (hm : m ≠ 0) (α : ℝ) :
    π.bracket (rungeLenz m α q p ρ 0) (rungeLenz m α q p ρ 1) =
      -(2 * algebraMap ℝ P m * hamiltonian m α p ρ +
          algebraMap ℝ P m * algebraMap ℝ P α * ρ * constraint q ρ) *
        angularMomentum q p 2 := by
  have hh := two_mul_algebraMap_half (P := P) m
  have hmm := algebraMap_mul_inv (P := P) hm
  simp [rungeLenz, angularMomentum, hamiltonian, constraint, cross_apply, dotProduct,
    Fin.sum_univ_three, AlmostPoissonStructure.bracket_sub_left,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_left,
    AlmostPoissonStructure.bracket_mul_right, h.q_q, h.p_p, h.q_p, h.p_q, h.ρ_q, h.q_ρ, h.ρ_p,
    h.p_ρ]
  linear_combination
    (algebraMap ℝ P m * (p 0 * p 0 + p 1 * p 1 + p 2 * p 2) * (q 0 * p 1 - q 1 * p 0)) * hh +
    ((p 0 * p 0 + p 1 * p 1 + p 2 * p 2) * (q 0 * p 1 - q 1 * p 0)) * hmm

theorem rungeLenz_one_rungeLenz_two (h : IsFrame π q p ρ) {m : ℝ} (hm : m ≠ 0) (α : ℝ) :
    π.bracket (rungeLenz m α q p ρ 1) (rungeLenz m α q p ρ 2) =
      -(2 * algebraMap ℝ P m * hamiltonian m α p ρ +
          algebraMap ℝ P m * algebraMap ℝ P α * ρ * constraint q ρ) *
        angularMomentum q p 0 := by
  have hh := two_mul_algebraMap_half (P := P) m
  have hmm := algebraMap_mul_inv (P := P) hm
  simp [rungeLenz, angularMomentum, hamiltonian, constraint, cross_apply, dotProduct,
    Fin.sum_univ_three, AlmostPoissonStructure.bracket_sub_left,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_left,
    AlmostPoissonStructure.bracket_mul_right, h.q_q, h.p_p, h.q_p, h.p_q, h.ρ_q, h.q_ρ, h.ρ_p,
    h.p_ρ]
  linear_combination
    (algebraMap ℝ P m * (p 0 * p 0 + p 1 * p 1 + p 2 * p 2) * (q 1 * p 2 - q 2 * p 1)) * hh +
    ((p 0 * p 0 + p 1 * p 1 + p 2 * p 2) * (q 1 * p 2 - q 2 * p 1)) * hmm

theorem rungeLenz_two_rungeLenz_zero (h : IsFrame π q p ρ) {m : ℝ} (hm : m ≠ 0) (α : ℝ) :
    π.bracket (rungeLenz m α q p ρ 2) (rungeLenz m α q p ρ 0) =
      -(2 * algebraMap ℝ P m * hamiltonian m α p ρ +
          algebraMap ℝ P m * algebraMap ℝ P α * ρ * constraint q ρ) *
        angularMomentum q p 1 := by
  have hh := two_mul_algebraMap_half (P := P) m
  have hmm := algebraMap_mul_inv (P := P) hm
  simp [rungeLenz, angularMomentum, hamiltonian, constraint, cross_apply, dotProduct,
    Fin.sum_univ_three, AlmostPoissonStructure.bracket_sub_left,
    AlmostPoissonStructure.bracket_sub_right, AlmostPoissonStructure.bracket_mul_left,
    AlmostPoissonStructure.bracket_mul_right, h.q_q, h.p_p, h.q_p, h.p_q, h.ρ_q, h.q_ρ, h.ρ_p,
    h.p_ρ]
  linear_combination
    (algebraMap ℝ P m * (p 0 * p 0 + p 1 * p 1 + p 2 * p 2) * (q 2 * p 0 - q 0 * p 2)) * hh +
    ((p 0 * p 0 + p 1 * p 1 + p 2 * p 2) * (q 2 * p 0 - q 0 * p 2)) * hmm

/-- The brackets of the Runge–Lenz vector (Landau–Lifshitz §15):
`{Aₐ, A_b} = −2 m H εₐ_bc M_c` up to the constraint. -/
theorem rungeLenz_rungeLenz (h : IsFrame π q p ρ) {m : ℝ} (hm : m ≠ 0) (α : ℝ) (a b : Fin 3) :
    π.bracket (rungeLenz m α q p ρ a) (rungeLenz m α q p ρ b) =
      -(2 * algebraMap ℝ P m * hamiltonian m α p ρ +
          algebraMap ℝ P m * algebraMap ℝ P α * ρ * constraint q ρ) *
        epsilon (angularMomentum q p) a b := by
  have h01 := h.rungeLenz_zero_rungeLenz_one hm α
  have h12 := h.rungeLenz_one_rungeLenz_two hm α
  have h20 := h.rungeLenz_two_rungeLenz_zero hm α
  have h10 : π.bracket (rungeLenz m α q p ρ 1) (rungeLenz m α q p ρ 0) = _ :=
    (π.antisymm _ _).trans (congrArg Neg.neg h01)
  have h21 : π.bracket (rungeLenz m α q p ρ 2) (rungeLenz m α q p ρ 1) = _ :=
    (π.antisymm _ _).trans (congrArg Neg.neg h12)
  have h02 : π.bracket (rungeLenz m α q p ρ 0) (rungeLenz m α q p ρ 2) = _ :=
    (π.antisymm _ _).trans (congrArg Neg.neg h20)
  fin_cases a <;> fin_cases b
  · simp [epsilon, AlmostPoissonStructure.bracket_self]
  · simpa [epsilon] using h01
  · simp only [Fin.zero_eta, Fin.reduceFinMk, h02, epsilon]
    simp
  · simp only [Fin.mk_one, Fin.zero_eta, h10, epsilon]
    simp
  · simp [epsilon, AlmostPoissonStructure.bracket_self]
  · simpa [epsilon] using h12
  · simpa [epsilon] using h20
  · simp only [Fin.reduceFinMk, Fin.mk_one, h21, epsilon]
    simp
  · simp [epsilon, AlmostPoissonStructure.bracket_self]

/-- The Runge–Lenz vector is conserved modulo the constraint ideal. -/
theorem rungeLenz_hamiltonian_mem (h : IsFrame π q p ρ) {m : ℝ} (hm : m ≠ 0) (α : ℝ)
    (a : Fin 3) :
    π.bracket (rungeLenz m α q p ρ a) (hamiltonian m α p ρ) ∈
      Ideal.span {constraint q ρ} := by
  rw [h.rungeLenz_hamiltonian hm α a]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

end IsFrame

end ProjectAInos.Mechanics.Kepler
