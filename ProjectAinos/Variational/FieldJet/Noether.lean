module

public import ProjectAinos.Variational.FieldJet.Euler
public import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic.Ring

/-!
# Noether's identities for a Lagrangian of the first order

A Lagrangian of the first order involves the fields `uᵃ` and their first derivatives `uᵃ_μ`.
Its momenta are `π^μ_a = ∂L/∂uᵃ_μ`, and its canonical stress tensor is
`T^μ_ν = Σₐ uᵃ_ν π^μ_a − δ^μ_ν L`. Three identities hold in every jet ring of fields:

* `euler_of_firstOrder`: `Eₐ(L) = ∂L/∂uᵃ − Σ_μ D_μ π^μ_a`;
* `prolong_eq_euler_add_divergence`, Noether's identity:
  `pr ξ(L) = Σₐ ξᵃ Eₐ(L) + Σ_μ D_μ (Σₐ ξᵃ π^μ_a)` for every variation `ξ` of the fields;
* `divergence_stress`: `Σ_μ D_μ T^μ_ν = −Σₐ uᵃ_ν Eₐ(L) − ∂_ν L`.

A current `P` is conserved for `L` if its divergence `Σ_μ D_μ P^μ` is in the Euler–Lagrange
ideal, which is generated by the total derivatives of the Euler–Lagrange expressions. Hence a
variation that changes the Lagrangian by a divergence gives a conserved current
(`conserved_noetherCurrent`), and the stress tensor is conserved when the Lagrangian does not
depend on the independent variables explicitly (`conserved_stress`). No section, integral or
solution is involved.
-/

@[expose] public section

noncomputable section

namespace ProjectAinos.Variational.FieldJetRing

open SmoothAlgebra

variable {ι κ J : Type*} [CommRing J] [Algebra ℝ J] [SmoothRing J] [Fintype κ] [Fintype ι]
  [DecidableEq ι] (R : FieldJetRing ι κ J)

/-- The multi-indices of the first order: the empty one and the single indices. -/
def firstOrderIndices (ι : Type*) [Fintype ι] [DecidableEq ι] : Finset (Multiset ι) :=
  insert 0 (Finset.univ.image fun μ : ι => ({μ} : Multiset ι))

/-- A Lagrangian of the first order: it involves the fields and their first derivatives. -/
def FirstOrder (L : J) : Prop := R.SupportIn L (firstOrderIndices ι)

/-- The momentum `π^μ_a = ∂L/∂uᵃ_μ`. -/
def momentum (L : J) (a : κ) (μ : ι) : J := R.d a {μ} L

/-- The divergence `Σ_μ D_μ P^μ` of a current. -/
def divergence (P : ι → J) : J := ∑ μ, R.totalDeriv μ (P μ)

/-- The prolongation `pr ξ = Σ_K Σₐ (D^K ξᵃ) ∂ᵃ_K` of a variation of the fields. -/
def prolong (ξ : κ → J) (F : J) : J :=
  ∑ᶠ K : Multiset ι, ∑ a, R.iterTotalDeriv K (ξ a) * R.d a K F

/-- The canonical stress tensor `T^μ_ν = Σₐ uᵃ_ν π^μ_a − δ^μ_ν L`. -/
def stress (L : J) (μ ν : ι) : J :=
  ∑ a, R.u a {ν} * R.momentum L a μ - if μ = ν then L else 0

variable {R}

theorem sum_firstOrderIndices {M : Type*} [AddCommMonoid M] (f : Multiset ι → M) :
    ∑ K ∈ firstOrderIndices ι, f K = f 0 + ∑ μ, f {μ} := by
  have h0 : (0 : Multiset ι) ∉ Finset.univ.image fun μ : ι => ({μ} : Multiset ι) := by simp
  rw [firstOrderIndices, Finset.sum_insert h0,
    Finset.sum_image fun μ _ ν _ h => Multiset.singleton_inj.mp h]

omit [Fintype ι] in
theorem iterTotalDeriv_singleton (μ : ι) (F : J) :
    R.iterTotalDeriv {μ} F = R.totalDeriv μ F := by
  rw [← Multiset.cons_zero, iterTotalDeriv_cons, iterTotalDeriv_zero]

/-- For a Lagrangian of the first order the Euler operator is
`∂L/∂uᵃ − Σ_μ D_μ (∂L/∂uᵃ_μ)`. -/
theorem euler_of_firstOrder {L : J} (hL : R.FirstOrder L) (a : κ) :
    R.euler a L = R.d a 0 L - R.divergence (R.momentum L a) := by
  rw [euler_eq_sum hL, sum_firstOrderIndices, divergence]
  simp only [Multiset.card_zero, pow_zero, one_mul, iterTotalDeriv_zero, Multiset.card_singleton,
    pow_one, iterTotalDeriv_singleton, momentum, neg_one_mul, Finset.sum_neg_distrib]
  ring

/-- The total derivative of a Lagrangian of the first order. -/
theorem totalDeriv_of_firstOrder {L : J} (hL : R.FirstOrder L) (ν : ι) :
    R.totalDeriv ν L = R.dx ν L + ∑ a, R.u a {ν} * R.d a 0 L +
      ∑ μ, ∑ a, R.u a (ν ::ₘ {μ}) * R.momentum L a μ := by
  rw [totalDeriv_eq_sum ν hL, sum_firstOrderIndices, add_assoc]
  rfl

theorem prolong_of_firstOrder {L : J} (hL : R.FirstOrder L) (ξ : κ → J) :
    R.prolong ξ L = ∑ a, ξ a * R.d a 0 L +
      ∑ μ, ∑ a, R.totalDeriv μ (ξ a) * R.momentum L a μ := by
  have hsupp : (Function.support fun K : Multiset ι =>
      ∑ a, R.iterTotalDeriv K (ξ a) * R.d a K L) ⊆ ↑(firstOrderIndices ι) := by
    intro K hK
    rw [Function.mem_support] at hK
    by_contra hS
    refine hK (Finset.sum_eq_zero fun a _ => ?_)
    rw [hL a K (by simpa using hS), mul_zero]
  rw [prolong, finsum_eq_sum_of_support_subset _ hsupp, sum_firstOrderIndices]
  simp only [iterTotalDeriv_zero, iterTotalDeriv_singleton, momentum]

/-- The divergence of the current `Σₐ ξᵃ π^μ_a`. -/
theorem divergence_sum_mul_momentum (L : J) (ξ : κ → J) :
    R.divergence (fun μ => ∑ a, ξ a * R.momentum L a μ) =
      ∑ a, ξ a * R.divergence (R.momentum L a) +
        ∑ μ, ∑ a, R.totalDeriv μ (ξ a) * R.momentum L a μ := by
  simp only [divergence, map_sum, SmoothDerivation.map_mul, smul_eq_mul, Finset.sum_add_distrib,
    Finset.mul_sum]
  rw [Finset.sum_comm]
  congr 1
  exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun a _ => mul_comm _ _

/-- Noether's identity `pr ξ(L) = Σₐ ξᵃ Eₐ(L) + Σ_μ D_μ (Σₐ ξᵃ π^μ_a)`. It holds for every
variation `ξ`. -/
theorem prolong_eq_euler_add_divergence {L : J} (hL : R.FirstOrder L) (ξ : κ → J) :
    R.prolong ξ L = ∑ a, ξ a * R.euler a L +
      R.divergence (fun μ => ∑ a, ξ a * R.momentum L a μ) := by
  rw [prolong_of_firstOrder hL, divergence_sum_mul_momentum]
  simp only [euler_of_firstOrder hL, mul_sub, Finset.sum_sub_distrib]
  ring

/-- If a variation changes the Lagrangian by a divergence `Σ_μ D_μ F^μ`, the Noether current
`Σₐ ξᵃ π^μ_a − F^μ` has the divergence `−Σₐ ξᵃ Eₐ(L)`. -/
theorem divergence_noetherCurrent {L : J} (hL : R.FirstOrder L) (ξ : κ → J) {F : ι → J}
    (h : R.prolong ξ L = R.divergence F) :
    R.divergence (fun μ => ∑ a, ξ a * R.momentum L a μ - F μ) = -∑ a, ξ a * R.euler a L := by
  have hsub : R.divergence (fun μ => ∑ a, ξ a * R.momentum L a μ - F μ) =
      R.divergence (fun μ => ∑ a, ξ a * R.momentum L a μ) - R.divergence F := by
    simp only [divergence, map_sub, Finset.sum_sub_distrib]
  rw [hsub, ← h, prolong_eq_euler_add_divergence hL]
  ring

/-- The divergence of the canonical stress tensor:
`Σ_μ D_μ T^μ_ν = −Σₐ uᵃ_ν Eₐ(L) − ∂_ν L`. -/
theorem divergence_stress {L : J} (hL : R.FirstOrder L) (ν : ι) :
    R.divergence (fun μ => R.stress L μ ν) = -∑ a, R.u a {ν} * R.euler a L - R.dx ν L := by
  have hdelta : ∑ μ, R.totalDeriv μ (if μ = ν then L else 0) = R.totalDeriv ν L := by
    rw [Finset.sum_eq_single ν]
    · simp only [↓reduceIte]
    · intro μ _ hμ
      simp only [hμ, ↓reduceIte, map_zero]
    · intro h
      exact absurd (Finset.mem_univ ν) h
  have hfirst : ∑ μ, R.totalDeriv μ (∑ a, R.u a {ν} * R.momentum L a μ) =
      ∑ a, R.u a {ν} * R.divergence (R.momentum L a) +
        ∑ μ, ∑ a, R.u a (ν ::ₘ {μ}) * R.momentum L a μ := by
    have h := divergence_sum_mul_momentum (R := R) L fun a => R.u a {ν}
    simp only [divergence] at h ⊢
    rw [h]
    congr 1
    refine Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun a _ => ?_
    rw [totalDeriv_u, ← Multiset.cons_zero ν, ← Multiset.cons_zero μ, Multiset.cons_swap]
  simp only [divergence, stress, map_sub, Finset.sum_sub_distrib]
  rw [hdelta, hfirst, totalDeriv_of_firstOrder hL]
  simp only [euler_of_firstOrder hL, mul_sub, Finset.sum_sub_distrib]
  ring

/-! ### Conserved currents -/

variable (R)

/-- The Euler–Lagrange ideal, generated by all total derivatives of the Euler–Lagrange
expressions. -/
def eulerLagrangeIdeal (L : J) : Ideal J :=
  Ideal.span {x | ∃ a K, x = R.iterTotalDeriv K (R.euler a L)}

/-- A current `P` is conserved for the Lagrangian `L`: its divergence lies in the
Euler–Lagrange ideal. -/
def Conserved (L : J) (P : ι → J) : Prop := R.divergence P ∈ R.eulerLagrangeIdeal L

variable {R}

omit [Fintype ι] in
theorem euler_mem (L : J) (a : κ) : R.euler a L ∈ R.eulerLagrangeIdeal L :=
  Ideal.subset_span ⟨a, 0, rfl⟩

omit [Fintype ι] in
/-- A combination of the Euler–Lagrange expressions lies in the Euler–Lagrange ideal. -/
theorem sum_mul_euler_mem (L : J) (ξ : κ → J) :
    ∑ a, ξ a * R.euler a L ∈ R.eulerLagrangeIdeal L :=
  sum_mem fun a _ => Ideal.mul_mem_left _ _ (euler_mem L a)

/-- Noether's theorem in a jet ring of fields: a variation that changes the Lagrangian by a
divergence gives a conserved current. -/
theorem conserved_noetherCurrent {L : J} (hL : R.FirstOrder L) (ξ : κ → J) {F : ι → J}
    (h : R.prolong ξ L = R.divergence F) :
    R.Conserved L fun μ => ∑ a, ξ a * R.momentum L a μ - F μ := by
  rw [Conserved, divergence_noetherCurrent hL ξ h]
  exact neg_mem (sum_mul_euler_mem L ξ)

/-- The canonical stress tensor is conserved when the Lagrangian does not depend explicitly on
the independent variable `x_ν`. -/
theorem conserved_stress {L : J} (hL : R.FirstOrder L) (ν : ι) (hx : R.dx ν L = 0) :
    R.Conserved L fun μ => R.stress L μ ν := by
  rw [Conserved, divergence_stress hL, hx, sub_zero]
  exact neg_mem (sum_mul_euler_mem L fun a => R.u a {ν})

end ProjectAinos.Variational.FieldJetRing
